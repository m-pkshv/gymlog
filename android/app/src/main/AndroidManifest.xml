<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rest-timer local notifications (Stage 4, TS 7.3, D-11). Runtime
         permission requested contextually, not at app startup; see
         NotificationService (D-10: Android 8+ minimum, this permission is
         only actually enforced starting Android 13, a no-op below that). -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Rest-timer notification delivery (Stage 12, owner-reported, real
         MIUI/HyperOS device): AndroidScheduleMode.alarmClock needs this.
         Diagnosed by live-testing on-device that inexactAllowWhileIdle
         reliably woke the app's broadcast receiver right on schedule
         (confirmed via dumpsys alarm/logcat) but the notification it tried
         to post from there never reached the tray, while an immediate
         foreground .show() always did; a scheduled alarmClock call threw
         PlatformException(exact_alarms_not_permitted) until this permission
         was declared. "Normal" permission (not dangerous, no runtime
         dialog) starting Android 12/13, but Android 14+ (API 34) requires
         the user to grant it manually via the special "Alarms & reminders"
         settings screen, requested contextually alongside
         POST_NOTIFICATIONS, same as that one, not at app startup. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Rest-timer notification delivery, root-cause fix (Stage 12,
         owner-reported "notifications never arrive" on a real MIUI/HyperOS
         device). Diagnosed via `adb shell dumpsys package dev.ironbook.app`:
         the app's Receiver Resolver Table contained no
         ScheduledNotificationReceiver at all, so AlarmManager's broadcast
         had nowhere to go, silently and with no exception anywhere in
         logcat. AndroidScheduleMode.alarmClock and SCHEDULE_EXACT_ALARM
         above were both red herrings found and fixed first; this is the
         actual root cause. flutter_local_notifications 22.1.0's own AAR
         manifest declares no receiver at all; its README (section "To
         schedule notifications") requires the app to declare both
         receivers below itself. Without RECEIVE_BOOT_COMPLETED, the boot
         receiver could never fire, so a rest-timer alarm scheduled before
         a device reboot would silently never arrive after it. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Profile avatar "Take photo" action (Stage 11, image_picker's
         ImageSource.camera). android.hardware.camera is marked not required
         so devices without a camera can still install the app: "Take
         photo" just won't work there, "Choose from gallery" still will. -->
    <uses-permission
        android:name="android.permission.CAMERA"/>
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>
    <application
        android:label="IronBook"
        android:name=".MainApplication"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Rest-timer notification delivery, root-cause fix (see the
             RECEIVE_BOOT_COMPLETED comment above for the full diagnosis).
             flutter_local_notifications 22.1.0 does not declare these in
             its own AAR manifest; the app must declare them itself
             (plugin README, "To schedule notifications"). Without these,
             AlarmManager's scheduled broadcast has no registered target
             to deliver to at all. This is why the rest-timer notification
             never arrived, on any Android version, regardless of the
             exact-alarm permission or notification-icon fixes tried
             earlier. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>